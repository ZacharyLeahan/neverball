# Generated by Codex CLI 0.144.6 (GPT-6).
# Adapted from neverball-nxdk ed3fd13f, continuing JayFoxRox/Jannik Vogel's port.
.DEFAULT_GOAL := hardware
ifeq ($(strip $(NXDK_DIR)),)
$(error Set NXDK_DIR to the isolated patched SDK)
endif
XBE_TITLE = Neverball-Upstream
OUTPUT_DIR = bin
NXDK_SDL = y
RENDERER = $(CURDIR)/build/deps/nxdk-gles11
CFLAGS = -DENABLE_OPENGLES=1 -DENABLE_NLS=0 -DENABLE_FETCH=0 -D_CRTIMP= -DHAVE_ALLOCA_H
CFLAGS += -DCONFIG_USER=\"D:\\\\Neverball\" -DCONFIG_DATA=\"D:\\\\Neverball\" -DCONFIG_LOCALE=\"D:\\\\Neverball\\\\locale\"
CFLAGS += -I$(CURDIR)/share -I$(CURDIR)/ball -I$(CURDIR)/xbox -I$(RENDERER)/include
SRCS = share/lang.c share/st_common.c share/vec3.c share/base_image.c share/image.c share/solid_base.c share/solid_vary.c share/solid_draw.c share/solid_all.c share/mtrl.c share/part.c share/geom.c share/ball.c share/ease.c share/transition.c share/gui.c share/font.c share/theme.c share/base_config.c share/config.c share/video.c share/glext.c share/binary.c share/state.c share/audio.c share/text.c share/common.c share/list.c share/queue.c share/cmd.c share/array.c share/dir.c share/fbo.c share/glsl.c share/fs_common.c share/fs_png.c share/fs_jpg.c share/fs_ov.c share/log.c share/joy.c share/package.c share/st_package.c share/mapclib.c ball/hud.c ball/game_common.c ball/game_client.c ball/game_server.c ball/game_proxy.c ball/game_draw.c ball/score.c ball/level.c ball/progress.c ball/set.c ball/demo.c ball/demo_dir.c ball/util.c ball/st_conf.c ball/st_demo.c ball/st_save.c ball/st_goal.c ball/st_fail.c ball/st_done.c ball/st_level.c ball/st_over.c ball/st_play.c ball/st_set.c ball/st_start.c ball/st_title.c ball/st_help.c ball/st_name.c ball/st_shared.c ball/st_pause.c ball/st_ball.c ball/st_game_link.c ball/main.c share/solid_sim_sol.c share/fs_stdio.c share/zip.c share/tilt_null.c share/hmd_null.c share/fetch_null.c xbox/platform.c xbox/st_exit.c putt/hud.c putt/game.c putt/hole.c putt/course.c putt/st_all.c
include xbox/Makefile-vorbis.xbox
include xbox/Makefile-ogg.xbox
RENDERER_LIBS = build/xbox-renderer/renderer/libGLESv1_CM.lib build/xbox-renderer/renderer/libswizzle.lib build/xbox-renderer/renderer/arena_build/libarena.lib
main.exe: $(RENDERER_LIBS) $(NXDK_DIR)/lib/libpbkit.lib
# CMake handles renderer dependency tracking; LLVM archive tools are required.
.PHONY: renderer hardware data
renderer:
	@cmake -S xbox -B build/xbox-renderer -DCMAKE_TOOLCHAIN_FILE=$(NXDK_DIR)/share/toolchain-nxdk.cmake -DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY
	@cmake --build build/xbox-renderer -j4
$(RENDERER_LIBS): renderer
	@test -f "$@"
hardware: bin/default.xbe
data:
	@python3 scripts/stage-xbox.py
share/version.h: scripts/version.sh neverball-version.txt
	@sh scripts/version.sh
$(SRCS:.c=.obj): share/version.h
include $(NXDK_DIR)/Makefile
NXDK_CFLAGS := $(CFLAGS) $(NXDK_CFLAGS)
CFLAGS := -Wno-deprecated-declarations
