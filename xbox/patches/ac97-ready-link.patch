diff --git a/lib/hal/audio.c b/lib/hal/audio.c
index 63cb592..7274638 100644
--- a/lib/hal/audio.c
+++ b/lib/hal/audio.c
@@ -172,16 +172,23 @@ void XAudioInit(int sampleSizeInBits, int numChannels, XAudioCallback callback,
 		pac97device->pcmOutDescriptor[i].bufferControl = 0;
 	}
 
-	// perform cold reset
-	pac97device->mmio[0x12C>>2] &= ~2;
-	LARGE_INTEGER Interval;
-	Interval.QuadPart = -10;
-	KeDelayExecutionThread(KernelMode, FALSE, &Interval);
-	pac97device->mmio[0x12C>>2] |= 2;
-	
-	// wait until the chip is finished resetting...
-	while(!(pac97device->mmio[0x130>>2]&0x100))
-		;
+	// Preserve an enabled, ready AC97 link. The DMA engines are reset below
+	// before replacing their descriptor lists.
+	const unsigned int globalControl = pac97device->mmio[0x12C>>2];
+	const unsigned int globalStatus = pac97device->mmio[0x130>>2];
+	if (!(globalControl & 2) || !(globalStatus & 0x100)) {
+		// perform cold reset
+		pac97device->mmio[0x12C>>2] &= ~2;
+		LARGE_INTEGER Interval;
+		Interval.QuadPart = -10;
+		KeDelayExecutionThread(KernelMode, FALSE, &Interval);
+		pac97device->mmio[0x12C>>2] |= 2;
+
+		// wait until the chip is finished resetting...
+		while(!(pac97device->mmio[0x130>>2]&0x100))
+			;
+
+	}
 
 	// reset bus master registers for analog output
 	pb[0x11B] = (1 << 4) | (1 << 3) | (1 << 2) | (1 << 1);
